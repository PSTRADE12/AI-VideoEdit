# Binaries + local installs (never commit FilmCraft itself — 146MB)
vendor/
tools/
filmcraft*.exe

# Per-machine / secrets
.env

# Working artifacts (keep folders via .gitkeep, ignore contents)
transcripts/*.json
transcripts/*.jsonl
transcripts/*.wav
transcripts/*.mp3
transcripts/pop*
*_out.txt
*_out.json
exports/*
!exports/.gitkeep
media/*
!media/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# FilmCraft projects can be huge — commit small demo ones only
*.fcproj
*.bak

# OS
.DS_Store
Thumbs.db
Desktop.ini
